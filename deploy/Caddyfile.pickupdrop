# Add this block to the server's Caddyfile (Caddy already owns 80/443 and
# handles TLS automatically — no certbot needed).
#
# The upstream is the API *container name* on the shared docker network:
# inside the caddy container 127.0.0.1 is caddy itself, not the host. The
# deploy workflow rewrites this line on every Blue-Green switch.
api.217.15.165.238.sslip.io {
	reverse_proxy pickupdrop-api-dev-BLUE:8080
}
